; Engine configuration file.
; It's best edited using the editor UI and not directly,
; unless you know what you're doing.

[application]

config/name="Het Debat - Dutch Politics Simulation Game"
config/description="Educational tool for understanding Dutch political systems and democratic processes"
config/version="1.0.0"
run/main_scene="res://ui/scenes/main_menu/MainMenu.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
boot_splash/bg_color=Color(0.2, 0.2, 0.4, 1.0)
boot_splash/show_image=false
config/icon="res://icon.png"

[autoload]

NavigationManager="*res://presentation/navigation_manager.gd"
GameStateManager="*res://presentation/game_state_manager.gd"
LocalizationManager="*res://presentation/localization_manager.gd"
AccessibilityManager="*res://presentation/accessibility_manager.gd"
UndoManager="*res://presentation/undo_manager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/resizable=true
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

theme/custom="res://ui/theme/default.tres"
theme/custom_font="res://ui/theme/fonts/default.ttf"

