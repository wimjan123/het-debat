[internationalization]

locale/translations=PackedStringArray("res://data/localization/strings_nl.po", "res://data/localization/strings_en.po")
locale/translations_pot_files=PackedStringArray("res://data/localization/strings.pot")

[layer_names]

2d_render/layer_1="UI_Background"
2d_render/layer_2="UI_Content"
2d_render/layer_3="UI_Overlay"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0