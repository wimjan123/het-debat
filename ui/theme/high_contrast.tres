# Political party colors - high contrast versions for accessibility
# These maintain party identity while ensuring adequate contrast
PartyColors/vvd = Color(0, 0.4, 1, 1)          # High contrast blue
PartyColors/pvda = Color(1, 0, 0, 1)            # Pure red
PartyColors/pvv = Color(1, 1, 0, 1)             # Pure yellow
PartyColors/cda = Color(0, 1, 0, 1)             # Pure green
PartyColors/d66 = Color(0, 1, 0.5, 1)           # Bright green
PartyColors/groenlinks = Color(0.3, 1, 0, 1)    # Bright green
PartyColors/sp = Color(1, 0.2, 0.2, 1)          # Bright red
PartyColors/cu = Color(0, 0.8, 1, 1)            # Bright cyan
PartyColors/sgp = Color(1, 0.5, 0, 1)           # Pure orange
PartyColors/fvd = Color(0.5, 0, 0, 1)           # Dark red
PartyColors/pvdd = Color(0, 0.6, 0.2, 1)        # Medium green
PartyColors/50plus = Color(0.6, 0, 1, 1)        # Purple
PartyColors/volt = Color(0.3, 0, 0.7, 1)        # Purple
PartyColors/ja21 = Color(0, 0.3, 1, 1)          # Blue
PartyColors/bij1 = Color(1, 1, 0.3, 1)          # Light yellow

# WCAG 2.1 AA compliance colors
# All colors tested for 4.5:1 contrast ratio against background
AccessibilityColors/background = Color(0, 0, 0, 1)
AccessibilityColors/surface = Color(0.1, 0.1, 0.1, 1)
AccessibilityColors/primary = Color(1, 1, 1, 1)
AccessibilityColors/secondary = Color(0.8, 0.8, 0.8, 1)
AccessibilityColors/accent = Color(1, 1, 0, 1)
AccessibilityColors/warning = Color(1, 0.6, 0, 1)
AccessibilityColors/error = Color(1, 0.3, 0.3, 1)
AccessibilityColors/success = Color(0.3, 1, 0.3, 1)
AccessibilityColors/focus = Color(1, 1, 0, 1)
AccessibilityColors/disabled = Color(0.5, 0.5, 0.5, 1)